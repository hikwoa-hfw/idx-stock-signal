# Virtual Environments
.venv/
venv/
env/
ENV/

# Environment Variables & Secrets
.env
.env.local
*.env
!*.env.example

# Python Cache & Build Artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.next/
out/

# Data & Datasets (keep directories via .gitkeep, ignore data files)
datasets/raw/*
!datasets/raw/.gitkeep
datasets/processed/*
!datasets/processed/.gitkeep
datasets/features/*
!datasets/features/.gitkeep
*.parquet
*.feather
*.csv
!configs/**/*.csv
!configs/universe/seed_universe.csv
*.tsv
*.xlsx
*.db
*.sqlite
*.sqlite3

# Models & Weights (keep directories via .gitkeep, ignore binary weights)
models/registry/*
!models/registry/.gitkeep
models/champion/*
!models/champion/.gitkeep
models/challengers/*
!models/challengers/.gitkeep
*.pkl
*.joblib
*.onnx
*.pt
*.bin

# Logs & Temporary files
logs/
*.log
tmp/
temp/

# OS & Editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
